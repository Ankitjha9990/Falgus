# Falgu Website — Environment Configuration Template
# Copy this file to .env or .env.local for local overrides.
# Note: Vite only exposes variables prefixed with VITE_ to the browser client bundle.

# Client-facing Formspree form ID (default: mwlllvlp)
# VITE_FORMSPREE_FORM_ID=mwlllvlp

# Vite dev server port (default: 5173)
# PORT=5173
